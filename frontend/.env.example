# Copy to .env.local and adjust.

# Use the built-in demo (mock) API so the UI works without a backend.
# Set to "false" once your model server is running.
VITE_USE_MOCK=true

# Base URL the browser calls. "/api" works with the Vite dev proxy and the Docker/nginx setup.
VITE_API_BASE_URL=/api

# Max upload size shown in the UI and enforced client-side (MB).
VITE_MAX_FILE_MB=20

# Dev server only: where /api/* is proxied (the backend that serves the Colab-trained model).
VITE_DEV_PROXY_TARGET=http://localhost:8000
