{
  "name": "kannada-ocr-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend for Kannada OCR — word, paragraph and full-page recognition",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.1.0",
    "@fontsource/noto-sans-kannada": "^5.1.0",
    "@fontsource/sora": "^5.1.0",
    "docx": "^9.0.0",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
